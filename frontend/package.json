{
  "name": "desktop-smart-file-butler",
  "private": true,
  "version": "0.1.0",
  "description": "\u901a\u8fc7\u81ea\u7136\u8bed\u8a00\u5b89\u5168\u6574\u7406\u3001\u5206\u7c7b\u548c\u6458\u8981\u672c\u5730\u6587\u4ef6\u7684\u684c\u9762 AI Agent",
  "author": "Desktop Smart File Butler Contributors",
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "build": "tsc -b && vite build && electron-builder --dir",
    "dist": "tsc -b && vite build && electron-builder --win portable",
    "build:web": "tsc -b && vite build",
    "build:sidecar": "python ../backend/build_sidecar.py",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty false",
    "test": "tsc -p tsconfig.test.json --pretty false && tsc -p tsconfig.electron-test.json --pretty false && node .test-dist/state.test.js && node .test-dist/api.test.js && node .test-dist/features.test.js && node .electron-test-dist/singleInstance.test.js"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "6.1.1",
    "electron": "44.4.2",
    "@types/node": "26.6.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "concurrently": "10.0.5",
    "cross-env": "10.1.0",
    "electron-builder": "26.15.3",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "wait-on": "9.1.0"
  },
  "build": {
    "appId": "com.filebutler.desktop",
    "productName": "\u684c\u9762\u667a\u80fd\u6587\u4ef6\u7ba1\u5bb6",
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../backend/dist/butler-backend.exe",
        "to": "backend/butler-backend.exe"
      }
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "portable"
    }
  }
}
