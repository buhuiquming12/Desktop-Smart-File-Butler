# ===== 模型配置 =====
# 提供方: openai | ollama
MODEL_PROVIDER=openai

# --- 外部大模型 API（OpenAI 兼容协议，推荐）---
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o-mini
# 官方 OpenAI 或任意兼容服务商；使用第三方 API 时取消注释并替换
# OPENAI_BASE_URL=https://api.openai.com/v1

# --- Ollama（本地模型）---
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5

# ===== 安全：允许操作的根目录（; 分隔）=====
# 所有文件操作被限制在这些目录内，越界一律拒绝
SANDBOX_ROOTS=C:\Users\me\Downloads;C:\Users\me\Desktop

# ===== OCR =====
# Tesseract 可执行文件路径（未安装可留空，OCR 功能将不可用）
TESSERACT_CMD=

# ===== 存储 =====
DB_PATH=./data/butler.db
CHROMA_DIR=./data/chroma
LOG_DIR=./logs

# ===== 服务 =====
HOST=127.0.0.1
PORT=8000
