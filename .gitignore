# ============ Python 后端 ============
__pycache__/
*.py[cod]
*.pyo
*$py.class
.venv/
venv/
env/
.eggs/
*.egg-info/
build/
dist/
.mypy_cache/
.ruff_cache/
.pytest_cache/
# pytest --basetemp 的落点：仓库根与 backend/ 的固定目录，以及临时的 -run/-full 变体
.pytest-tmp*/
.tox/
.nox/
.coverage
.coverage.*
htmlcov/
coverage.xml

# ============ Node / 前端 ============
node_modules/
frontend/dist/
frontend/dist-electron/
frontend/release/
frontend/.vite/
frontend/.test-dist/
frontend/.electron-test-dist/
*.tsbuildinfo
*.local
package-lock.json
!frontend/package-lock.json
backend/*.spec

# ============ 本地配置 / 数据 ============
.env
.env.*
!.env.example
data/
logs/
backend/data/
backend/logs/
# SQLite 主库与 WAL 边车文件：journal_mode=WAL 会额外生成 -wal / -shm
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite-wal
*.sqlite-shm
*.sqlite3
*.log
*.log.*

# ============ 本地 Agent / 工具数据 ============
# 会话记忆与运行数据属于本机状态，不入库；项目级 skills 需要团队共享，显式放行
.workbuddy/*
!.workbuddy/skills/
.codex/
.agents/

# ============ 编辑器 / IDE ============
.idea/
.vscode/
.history/
*.swp
*.swo
*~

# ============ 操作系统 / 杂项 ============
